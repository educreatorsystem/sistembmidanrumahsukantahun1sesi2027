const SHEET_ID='1ARQfvtVDyjO_jeKnv1aGetDQVJzUQdmghq7JLwaLljQ';
const P=PropertiesService.getScriptProperties();
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Tempahan Baju Sukan Tahun 1 • 2027').addMetaTag('viewport','width=device-width, initial-scale=1');}
function sheet_(){const ss=SpreadsheetApp.openById(SHEET_ID);let s=ss.getSheetByName('Tempahan2027_Private');if(!s){s=ss.insertSheet('Tempahan2027_Private');s.appendRow(['Rujukan','MyKid','Data JSON','Dikemas kini']);s.getRange('A:D').setNumberFormat('@');}return s;}
function settings_(){return JSON.parse(P.getProperty('settings')||JSON.stringify({school:'SK SUNGAI TIRAM',logo:'',image:'',price:0,ready:false,open:'2026-11-26T00:00',close:'2027-01-15T23:59',allowEdit:true,instructions:'Sila rujuk carta ukuran pembekal sebelum memilih saiz.',classes:[],sizes:[]}));}
function rows_(){const s=sheet_();return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,4).getValues().map((r,i)=>({row:i+2,data:JSON.parse(r[2])}));}
function digest_(v){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v));}
function derive_(pass,salt){const key=Utilities.newBlob(pass).getBytes();let u=Utilities.computeHmacSha256Signature(salt+'\x00\x00\x00\x01',pass),out=u.slice();for(let i=1;i<100000;i++){u=Utilities.computeHmacSha256Signature(u,key);for(let j=0;j<32;j++)out[j]^=u[j];}return Utilities.base64Encode(out);}
function setPassword_(password){const salt=Utilities.getUuid();P.setProperties({salt:salt,password:derive_(password,salt)});}
// Run once from the editor. The initial password is never sent to the browser.
function setup(){sheet_();if(!P.getProperty('password'))setPassword_('skst@1234');}
function auth_(token){const k='session:'+digest_(String(token||'')),raw=P.getProperty(k);if(!raw)throw Error('Sesi tamat. Sila log masuk semula.');const s=JSON.parse(raw);if(Date.now()-s.last>1800000){P.deleteProperty(k);throw Error('Sesi tamat. Sila log masuk semula.');}s.last=Date.now();P.setProperty(k,JSON.stringify(s));return k;}
function window_(s){const now=Date.now();return s.ready&&now>=new Date(s.open+'+08:00').getTime()&&now<=new Date(s.close+'+08:00').getTime();}
function clean_(v,max){return String(v||'').trim().slice(0,max||200);}
function phone_(v){return String(v||'').replace(/\D/g,'').replace(/^60/,'0');}
function validate_(d,s,old,admin){const n={name:clean_(d.name),mykid:clean_(d.mykid),guardian:clean_(d.guardian),phone:phone_(d.phone),className:clean_(d.className),notes:clean_(d.notes,1000)};if(!n.name||!n.guardian||!/^\d{12}$/.test(n.mykid)||!/^0\d{8,10}$/.test(n.phone))throw Error('Sila isi nama, MyKid 12 digit dan nombor telefon yang sah.');if(!['Belum ditetapkan'].concat(s.classes).includes(n.className))throw Error('Kelas tidak sah.');if(!Array.isArray(d.items)||!d.items.length||d.items.length>30)throw Error('Pilih sekurang-kurangnya satu saiz.');const seen={};n.items=d.items.map(x=>{const size=s.sizes.find(z=>z.id===x.id);const previous=old&&old.items.find(z=>z.id===x.id);if(!size||(!size.active&&!previous)||seen[x.id]||!Number.isInteger(Number(x.qty))||Number(x.qty)<1||Number(x.qty)>999)throw Error('Saiz atau kuantiti tidak sah.');seen[x.id]=1;return {id:size.id,label:size.label,qty:Number(x.qty)};});n.quantity=n.items.reduce((a,x)=>a+x.qty,0);n.unitPrice=old?old.unitPrice:s.price;n.total=Math.round(n.quantity*n.unitPrice*100)/100;return n;}
function write_(n,row){const s=sheet_();s.getRange(row||s.getLastRow()+1,1,1,4).setValues([[n.ref,n.mykid,JSON.stringify(n),n.updated]]);SpreadsheetApp.flush();}
function api(action,p){p=p||{};const lock=LockService.getScriptLock();lock.waitLock(30000);try{const s=settings_();if(action==='public')return {ok:true,data:{settings:s,isOpen:window_(s),now:new Date().toISOString()}};
if(action==='login'){const key='loginFailures',f=JSON.parse(P.getProperty(key)||'{"count":0,"until":0}');if(f.until>Date.now())throw Error('Terlalu banyak cubaan. Cuba lagi dalam 15 minit.');if(p.username!=='admin'||derive_(String(p.password||''),P.getProperty('salt')||'')!==P.getProperty('password')){f.count++;if(f.count>=5){f.until=Date.now()+900000;f.count=0;}P.setProperty(key,JSON.stringify(f));throw Error('Username atau kata laluan tidak sah');}P.deleteProperty(key);const token=Utilities.getUuid()+Utilities.getUuid();P.setProperty('session:'+digest_(token),JSON.stringify({last:Date.now()}));return {ok:true,data:{token}};}
if(action==='lookup'){const key='lookup:'+digest_(clean_(p.ref)+phone_(p.phone)),f=JSON.parse(P.getProperty(key)||'{"count":0,"time":0}');if(Date.now()-f.time>900000){f.count=0;f.time=Date.now();}if(f.count>=10)throw Error('Terlalu banyak cubaan. Cuba lagi kemudian.');const found=rows_().find(x=>x.data.ref===clean_(p.ref).toUpperCase()&&x.data.phone===phone_(p.phone));if(!found){f.count++;P.setProperty(key,JSON.stringify(f));throw Error('Tempahan tidak ditemui. Semak nombor rujukan dan telefon.');}P.deleteProperty(key);return {ok:true,data:found.data};}
if(action==='create'||action==='parentUpdate'){if(!window_(s))throw Error('Tempahan belum dibuka atau telah ditutup.');const rows=rows_();let old=null;if(action==='parentUpdate'){if(!s.allowEdit)throw Error('Pembetulan tidak dibenarkan.');old=rows.find(x=>x.data.ref===p.ref&&x.data.phone===phone_(p.phone)&&x.data.status!=='Dibatalkan');if(!old)throw Error('Tempahan tidak ditemui.');}const n=validate_(p.order,s,old&&old.data);if(old&&n.mykid!==old.data.mykid)throw Error('MyKid tidak boleh ditukar melalui semakan ibu bapa.');const duplicate=rows.find(x=>x.data.mykid===n.mykid&&x.data.status!=='Dibatalkan'&&(!old||x.row!==old.row));if(duplicate){if(p.requestId&&duplicate.data.requestId===p.requestId)return {ok:true,data:duplicate.data};throw Error('MyKid ini mempunyai tempahan aktif. Gunakan Semak Tempahan untuk mengemas kini.');}const now=new Date().toISOString();Object.assign(n,{ref:old?old.data.ref:'TS27-'+Utilities.getUuid().replace(/-/g,'').slice(0,12).toUpperCase(),created:old?old.data.created:now,updated:now,status:'Menunggu',requestId:clean_(p.requestId)});write_(n,old&&old.row);return {ok:true,data:n};}
const session=auth_(p.token);
if(action==='logout'){P.deleteProperty(session);return {ok:true};}
if(action==='adminData')return {ok:true,data:{settings:s,orders:rows_().map(x=>x.data)}};
if(action==='password'){if(String(p.password||'').length<10)throw Error('Gunakan sekurang-kurangnya 10 aksara.');setPassword_(p.password);P.getKeys().filter(k=>k.startsWith('session:')).forEach(k=>P.deleteProperty(k));return {ok:true};}
if(action==='settings'){const n=p.settings;if(!n.school||!Number.isFinite(Number(n.price))||Number(n.price)<0||!Array.isArray(n.sizes)||!Array.isArray(n.classes))throw Error('Tetapan tidak sah.');if(!/^\d{4}-\d\d-\d\dT\d\d:\d\d$/.test(n.open)||!/^\d{4}-\d\d-\d\dT\d\d:\d\d$/.test(n.close)||n.close<=n.open)throw Error('Tarikh tidak sah.');const ids={};n.sizes.forEach(z=>{if(!z.id||ids[z.id]||!z.label||!['cm','inci'].includes(z.unit)||!Number.isFinite(Number(z.chest))||Number(z.chest)<=0||!Number.isFinite(Number(z.length))||Number(z.length)<=0)throw Error('Lengkapkan ukuran setiap saiz.');ids[z.id]=true;});rows_().forEach(r=>r.data.items.forEach(i=>{if(!ids[i.id])throw Error('Saiz yang digunakan tidak boleh dipadam. Nyahaktifkan sahaja.');}));n.price=Number(n.price);['logo','image'].forEach(k=>{if(n[k]&&!/^https:\/\//.test(n[k]))throw Error('Gunakan URL gambar HTTPS.');});if(Utilities.newBlob(JSON.stringify(n)).getBytes().length>8500)throw Error('Tetapan terlalu panjang. Ringkaskan arahan atau senarai saiz.');P.setProperty('settings',JSON.stringify(n));return {ok:true,data:n};}
if(action==='adminUpdate'){const old=rows_().find(x=>x.data.ref===p.ref);if(!old)throw Error('Tempahan tidak ditemui.');const n=validate_(p.order,s,old.data,true);if(rows_().some(x=>x.row!==old.row&&x.data.mykid===n.mykid&&x.data.status!=='Dibatalkan')&&p.status!=='Dibatalkan')throw Error('MyKid mempunyai tempahan aktif.');if(!['Menunggu','Disahkan','Dibatalkan'].includes(p.status))throw Error('Status tidak sah.');Object.assign(n,{ref:old.data.ref,created:old.data.created,updated:new Date().toISOString(),status:p.status});write_(n,old.row);return {ok:true,data:n};}throw Error('Tindakan tidak sah.');
}catch(e){return {ok:false,error:e.message};}finally{lock.releaseLock();}}
